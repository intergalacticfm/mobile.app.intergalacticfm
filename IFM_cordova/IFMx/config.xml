<?xml version='1.0' encoding='utf-8'?>
<widget id="fm.intergalactic" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>IntergalacticFM</name>
    <description>Sample Apache Cordova App</description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="AllowInlineMediaPlayback" value="true" />
    <preference name="MediaPlaybackRequiresUserAction" value="false" />

    <platform name="ios">
        <!-- iOS 8.0+ -->
        <!-- iPhone 6 Plus  -->
        <icon src="icons/ios/60@3x.png" width="180" height="180" />
        <!-- iOS 7.0+ -->
        <!-- iPhone / iPod Touch  -->
        <icon src="icons/ios/60.png" width="60" height="60" />
        <icon src="icons/ios/60@2x.png" width="120" height="120" />
        <!-- iPad -->
        <icon src="icons/ios/76.png" width="76" height="76" />
        <icon src="icons/ios/76@2x.png" width="152" height="152" />
        <!-- Spotlight Icon -->
        <icon src="icons/ios/40.png" width="40" height="40" />
        <icon src="icons/ios/40@2x.png" width="80" height="80" />
        <!-- iPad -->
        <icon src="icons/ios/72.png" width="72" height="72" />
        <icon src="icons/ios/72@2x.png" width="144" height="144" />
        <!-- iPad Pro -->
        <icon src="icons/ios/167.png" width="167" height="167" />
        <!-- iPhone Spotlight and Settings Icon -->
        <icon src="icons/ios/small.png" width="29" height="29" />
        <icon src="icons/ios/small@2x.png" width="58" height="58" />
        <icon src="icons/ios/small@3x.png" width="87" height="87" />
        <!-- iPad Spotlight and Settings Icon -->
        <icon src="icons/ios/50.png" width="50" height="50" />
        <icon src="icons/ios/50@2x.png" width="100" height="100" />
        <!-- iTunes Marketing Image -->
        <icon src="icons/ios/1024.png" width="1024" height="1024" />
    </platform>
    <platform name="android">
        <!--
            ldpi    : 36x36 px
            mdpi    : 48x48 px
            hdpi    : 72x72 px
            xhdpi   : 96x96 px
            xxhdpi  : 144x144 px
            xxxhdpi : 192x192 px
        -->
        <icon src="icons/android/ldpi.png" density="ldpi" />
        <icon src="icons/android/mdpi.png" density="mdpi" />
        <icon src="res/android/hdpi.png" density="hdpi" />
        <icon src="res/android/xhdpi.png" density="xhdpi" />
        <icon src="res/android/xxhdpi.png" density="xxhdpi" />
        <icon src="res/android/xxxhdpi.png" density="xxxhdpi" />
    </platform>


</widget>
